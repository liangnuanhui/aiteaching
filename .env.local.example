# Local development environment variables (Next.js dev mode)
# Copy to `.env.local` and fill in credentials.

# Core
NODE_ENV=development

# NextAuth (JWT sessions)
# ⚠️ SECURITY WARNING:
#   - Generate a secure secret: openssl rand -base64 32
#   - NEVER use 'dev-secret' in production
#   - Minimum 32 characters required
#   - Authentication will fail with internal server errors if not set properly
#   - Use different secrets for dev/test/prod environments
NEXTAUTH_SECRET=dev-secret
NEXTAUTH_URL=http://localhost:3000

# OAuth providers (optional; must be set together)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limiting (KV-backed)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Analytics & logging
ANALYTICS_ENABLED=true
ANALYTICS_SINK=log
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_INCLUDE_TIMESTAMP=true

# Database & cache
DATABASE_QUERY_TIMEOUT=5000
CACHE_DEFAULT_TTL=3600

# Performance monitoring
ENABLE_PERFORMANCE_MONITORING=true
SLOW_QUERY_THRESHOLD_MS=1000

# ========================================
# 多模型分析配置
# ========================================

# 魔搭社区（必需）
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL_ID=

# OpenAI GPT-4 Vision（可选）
OPENAI_API_KEY=
ENABLE_GPT4_VISION=false

# Anthropic Claude Vision（可选）
ANTHROPIC_API_KEY=
ENABLE_CLAUDE_VISION=false

# 豆包视觉模型（可选）
DOUBAO_API_KEY=
ENABLE_DOUBAO_VL=false

# 模型权重（可选调整）
QWEN30B_WEIGHT=1.2
QWEN235B_WEIGHT=1.5
GPT4V_WEIGHT=1.0
CLAUDE_WEIGHT=1.1
DOUBAO_WEIGHT=0.9

# 超时配置（秒）
SINGLE_MODEL_TIMEOUT=30
MULTI_MODEL_TIMEOUT=60
